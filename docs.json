{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Driver",
  "redirects": [
    { "source": "/", "destination": "/docs" }
  ],
  "colors": {
    "primary": "#F0B15C",
    "light": "#FFD38A",
    "dark": "#C27C2C"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "docs/index",
              "docs/introduction/getting-started"
            ]
          },
          {
            "group": "Browser Sessions",
            "pages": [
              "docs/fundamentals/creating-a-browser-session",
              "docs/fundamentals/using-a-browser-session",
              "docs/fundamentals/best-practices",
              "docs/fundamentals/viewing-a-browser-session",
              "docs/fundamentals/managing-a-browser-session"
            ]
          },
          {
            "group": "Session Options",
            "pages": [
              "docs/features/browser-profiles",
              "docs/features/geolocation",
              "docs/features/node-selection",
              "docs/features/proxies",
              "docs/features/window-size"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "docs/integrations/playwright",
              "docs/integrations/puppeteer",
              "docs/integrations/browser-use",
              "docs/integrations/crawl4ai",
              "docs/integrations/stagehand"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Browser Sessions",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /v1/browser/session",
              "GET /v1/browser/session",
              "PATCH /v1/browser/session",
              "DELETE /v1/browser/session",
              "GET /v1/browser/sessions"
            ]
          },
          {
            "group": "Profiles",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /v1/browser/profiles",
              "DELETE /v1/browser/profile"
            ]
          },
          {
            "group": "Account",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "GET /v1/account/balance"
            ]
          },
          {
            "group": "Scrape",
            "openapi": "api-reference/openapi.json",
            "pages": [
              "POST /v1/scrape"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:alex@driver.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.driver.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BrowserCash/docs"
    }
  }
}
